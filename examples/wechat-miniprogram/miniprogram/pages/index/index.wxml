<view class="page">
  <view class="card">
    <text class="eyebrow">Kotlin/JS Consumer Bridge</text>
    <text class="label">SDK version</text>
    <text class="version">{{sdkVersion}}</text>
  </view>

  <view class="card">
    <text class="eyebrow">Runtime Lifecycle</text>
    <text class="label">App state and current route</text>
    <text class="status">{{lifecycleState}}</text>
    <text class="details">{{pageRoute}}</text>
    <text class="security-note">App state is host-neutral; the route is WeChat-specific.</text>
  </view>

  <view class="card">
    <text class="eyebrow">Runtime Detection and Version Gate</text>
    <text class="label">Base library and capability support</text>
    <text class="status status--{{runtimeStatus}}">{{runtimeStatus}}</text>
    <text class="details">{{runtimeDetails}}</text>
    <text class="security-note">Lower the debug base library below 2.20.1 to see VersionDependent.</text>
  </view>

  <view class="card">
    <text class="eyebrow">Permission Lifecycle</text>
    <text class="label">{{permissionName}}</text>
    <text class="status status--{{permissionStatus}}">{{permissionStatus}}</text>
    <text class="details">{{permissionDetails}}</text>
    <text class="security-note">Never requested on load, and a settings visit does not grant it.</text>
    <button class="action" bindtap="refreshPermission">Refresh permission state</button>
    <button class="action" bindtap="requestPermission">Request permission</button>
    <button class="action" bindtap="openPermissionSettings">Open settings</button>
  </view>

  <view class="card">
    <text class="eyebrow">Privacy Authorization</text>
    <text class="label">Requirement: {{privacyRequirement}}</text>
    <text class="status">{{privacyContract}}</text>
    <text class="details">Last action: {{privacyLastAction}}</text>
    <text class="details">{{privacyDetails}}</text>
    <text class="security-note">A host contract, not a system permission. No prompt starts on load.</text>
    <button class="action" bindtap="refreshPrivacy">Refresh privacy status</button>
    <button class="action" bindtap="requestPrivacy">Request privacy authorization</button>
  </view>

  <view class="card">
    <text class="eyebrow">WeChat Session Check</text>
    <text class="label">Client login state: {{sessionStatus}}</text>
    <text class="details">{{sessionDetails}}</text>
    <text class="security-note">A valid WeChat client session is not an authenticated user or backend session.</text>
    <button class="action" bindtap="checkSession">Check WeChat session</button>
  </view>

  <view class="card">
    <text class="eyebrow">Clipboard and Haptics</text>
    <text class="label">Clipboard write: {{clipboardWriteStatus}}</text>
    <text class="label">Clipboard read: {{clipboardReadStatus}}</text>
    <text class="details">{{clipboardDetails}}</text>
    <text class="label">Short vibration: {{hapticsShortStatus}}</text>
    <text class="label">Long vibration: {{hapticsLongStatus}}</text>
    <text class="details">{{hapticsDetails}}</text>
    <text class="security-note">Vibration is felt on a device; the log only records that WeChat accepted the call.</text>
    <button class="action" bindtap="writeClipboardTest">Write test text</button>
    <button class="action" bindtap="readClipboard">Read clipboard</button>
    <button class="action" bindtap="vibrateShort">Short vibration</button>
    <button class="action" bindtap="vibrateLong">Long vibration</button>
  </view>

  <view class="card">
    <text class="eyebrow">First Host Capability</text>
    <text class="label">Storage verification</text>
    <text class="status status--{{storageStatus}}">{{storageStatus}}</text>
    <text class="details">{{storageDetails}}</text>
  </view>

  <view class="card">
    <text class="eyebrow">WeChat-specific Bootstrap</text>
    <text class="label">Client login code</text>
    <text class="status status--{{authStatus}}">{{authStatus}}</text>
    <text class="details">{{authDetails}}</text>
    <text class="security-note">A login code is not an authenticated user or session.</text>
  </view>

  <view class="card">
    <text class="eyebrow">HTTP Transport Capability</text>
    <text class="label">Network verification</text>
    <text class="status status--{{networkStatus}}">{{networkStatus}}</text>
    <text class="details">{{networkDetails}}</text>
    <text class="security-note">The request domain must be whitelisted or domain checking disabled.</text>
  </view>

  <view class="card">
    <text class="eyebrow">WeChat-specific Navigation</text>
    <text class="label">Page stack bridge</text>
    <text class="status status--{{navigationStatus}}">{{navigationStatus}}</text>
    <text class="details">{{navigationDetails}}</text>
    <button class="action" bindtap="openSecondPage">Open second page (wx.navigateTo)</button>
  </view>
</view>
