page {
  background: #f5f7fa;
  color: #172033;
  font-family: sans-serif;
}

.page {
  padding: 48rpx 32rpx;
}

.card {
  display: flex;
  flex-direction: column;
  padding: 40rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 36rpx rgba(23, 32, 51, 0.08);
}

.card + .card {
  margin-top: 28rpx;
}

.eyebrow {
  color: #526079;
  font-size: 24rpx;
  letter-spacing: 1rpx;
}

.label {
  margin-top: 40rpx;
  color: #526079;
  font-size: 28rpx;
}

.version {
  margin-top: 12rpx;
  color: #172033;
  font-size: 48rpx;
  font-weight: 600;
}

.status {
  margin-top: 12rpx;
  color: #526079;
  font-size: 44rpx;
  font-weight: 600;
}

.status--PASS {
  color: #138a4b;
}

.status--FAIL {
  color: #c1352b;
}

.details,
.security-note {
  margin-top: 12rpx;
  color: #526079;
  font-size: 24rpx;
  line-height: 1.5;
}

.security-note {
  margin-top: 20rpx;
  color: #8a5b16;
}

.action {
  margin-top: 24rpx;
  border-radius: 16rpx;
  background: #172033;
  color: #ffffff;
  font-size: 28rpx;
}
