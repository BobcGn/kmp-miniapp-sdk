{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "target": "ES2019",
    "module": "Node16",
    "moduleResolution": "Node16",
    "skipLibCheck": true
  },
  "include": [
    "**/*.js",
    "libs/**/*.d.ts"
  ],
  "exclude": [
    "libs/**/*.js",
    "node_modules",
    "build"
  ]
}
